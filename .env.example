# Var förfrågningar från kontaktformuläret ska skickas.
# Se README.md → "Ta emot förfrågningar".

# POSTas som JSON till denna URL (t.ex. Zapier, Make, n8n, Slack-webhook-brygga, egen endpoint).
INQUIRY_WEBHOOK_URL=
# Valfri hemlighet som skickas som "Authorization: Bearer <värde>" till webhooken.
INQUIRY_WEBHOOK_SECRET=

# Endast för lokal utveckling: sparar förfrågningar i .data/forfragningar.jsonl.
# Är automatiskt aktivt när NODE_ENV=development. Sätt till "1" för att tvinga på i andra miljöer
# (kräver skrivbart filsystem – fungerar inte på t.ex. Vercel).
INQUIRY_FILE_STORE=
